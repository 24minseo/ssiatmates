# Supabase public client configuration
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Optional Google Search Console verification value. When set, it is emitted
# as a google-site-verification meta tag on every page.
VITE_GOOGLE_SITE_VERIFICATION=

# Server-only key required by the account deletion server function. Never use
# this variable in browser code or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n webhook URL. Do not prefix this with VITE_.
N8N_CALENDAR_TASK_WEBHOOK_URL=
N8N_CALENDAR_EVENTS_WEBHOOK_URL=
N8N_CALENDAR_EVENT_MUTATION_WEBHOOK_URL=

# Server-only IR HTML renderer authentication. Never prefix with VITE_.
IR_HTML_RENDER_SECRET=
